#!/usr/bin/env node
// Fake `opencode`: `opencode serve --hostname H --port N` runs the fake server; `--version` prints one.
const args = process.argv.slice(2);
if (args[0] === "--version") { console.log("1.18.35-fake"); process.exit(0); }
if (args[0] !== "serve") process.exit(2);
const port = Number(args[args.indexOf("--port") + 1]);
require("./oc-server.js").start(port);
