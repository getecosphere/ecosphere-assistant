{
  "manifest_version": 3,
  "name": "Ecosphere Assistant",
  "version": "1.2.2",
  "description": "Your Ecosphere estate in a sidebar: guided setup, build with AI, compose LXS, and deploy — one window for the whole workflow.",
  "homepage_url": "https://getecosphere.com/install",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle OpenCode sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
