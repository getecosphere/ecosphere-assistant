{
  "manifest_version": 3,
  "name": "Ecosphere Assistant",
  "version": "1.8.0",
  "description": "Your estate in a sidebar: guided setup, AI coding, compose your ecompose.yml, deploy — plus Ecosphere Projects for QA and Kanban.",
  "homepage_url": "https://getecosphere.com/install",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging", "storage", "tabs", "downloads", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://getecosphere.com/*",
    "https://project.getecosphere.com/*",
    "https://*.jogjaitcamp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["estate-detect.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle OpenCode sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
