{
  "manifest_version": 3,
  "name": "Ecosphere Assistant",
  "version": "2.0.0",
  "description": "Your /project dashboard and a coding agent that sees the page you are on, in Chrome's side panel. Everything runs on your machine.",
  "homepage_url": "https://getecosphere.com/install",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://getecosphere.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "pick-element": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Pick an element on the page for the agent"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ecosphere Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
